# =============================================================
# ficium-portal-api — Environment Variables
# Set all of these in Railway → ficium-portal-api → Variables
# =============================================================

# ── Database ──────────────────────────────────────────────────
# Supabase Transaction Pooler (port 6543) — Portal project
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# Supabase Transaction Pooler (port 6543) — Consumer App project
APP_DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# ── Auth (ficium-auth RS256) ───────────────────────────────────
AUTH_JWKS_URL=https://ficium-auth-production.up.railway.app/.well-known/jwks.json
AUTH_ISSUER=ficium-auth
# Must match the 'aud' claim in ficium-auth JWTs
AUTH_AUDIENCE=authenticated

# ── Server-to-server trust (consumer app → portal-api) ────────
APP_SERVICE_SECRET=<shared secret — same value in Vercel VITE_APP_SERVICE_SECRET + Supabase Vault>

# ── Borrower auth (Ficium App Supabase project — for /marketplace/borrower/*) ──
# anon/publishable key only. Never the App project's service_role key.
APP_SUPABASE_URL=https://<app-project-ref>.supabase.co
APP_SUPABASE_ANON_KEY=<Ficium App project's anon/publishable key>

# ── CORS ──────────────────────────────────────────────────────
# Exact comma-separated origins. Add your custom domain once live.
ALLOWED_ORIGINS=https://ficium-portal.vercel.app,https://portal.ficium.net

# Regex for dynamic origins — covers all Vercel preview deployments
# automatically. Do NOT set this to an empty string; leave it unset
# entirely to use the safe code default below, or set it explicitly.
# Default: ^https://ficium-portal[a-z0-9.\-]*\.vercel\.App$
ALLOWED_ORIGIN_REGEX=^https://ficium-portal[a-z0-9.\-]*\.vercel\.app$

# ── Deployment ────────────────────────────────────────────────
DEPLOYMENT_MODEL=saas
LOG_LEVEL=INFO
